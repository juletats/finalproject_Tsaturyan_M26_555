# Python: байт-код и кеши проверочных инструментов (ruff, mypy)
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/

# uv: виртуальное окружение и артефакты сборки (uv.lock остаётся в репозитории)
.venv
build/
dist/
*.egg-info/

# Valuta Trade Hub: логи доменных операций и локальная конфигурация
/logs/
config.json

# Ключи внешних API (EXCHANGERATE_API_KEY) в репозиторий не попадают
.env
.env.*

# Непарованные атомарные записи данных (TEMP_SUFFIX в infra/database.py)
*.tmp

# Среда разработки: настройки PyCharm и файлы macOS
.idea/
.DS_Store
